---
# ════════════════════════════════════════════════════════════════
# Kubernetes Cluster Configuration — Example File
# 사용법:
#   1. cp group_vars/all.yml.example group_vars/all.yml
#   2. 환경에 맞게 group_vars/all.yml 편집 (secret/도메인/IP)
#   3. group_vars/all.yml은 secret 포함 → 절대 커밋 금지
# 그룹 순서: 1.클러스터 → 2.HA → 3.CNI → 4.런타임/레지스트리
#           → 5.시스템 → 6.GPU → 7.보안 → 8.OS 패키지
# ════════════════════════════════════════════════════════════════


# ════════════════════════════════════════════════════════════════
# 1. 클러스터 기본
# Kubernetes 버전·네트워크 CIDR·마스터 스케줄링·인증서 연장.
# 지원 범위: k8s 1.27.x – 1.34.x (kubeadm v1beta3/v1beta4 자동 분기).
# ════════════════════════════════════════════════════════════════
kubernetes_version: '1.34.1'            # 지원: 1.27.x – 1.34.x, 권장: 1.34.1
dns_domain: cluster.local               # 클러스터 DNS 도메인
service_subnet: 10.96.0.0/12            # Service CIDR
pod_subnet: 10.244.0.0/16               # Pod CIDR (Flannel 기본값 일치)
allow_master_scheduling: true           # 마스터에 워크로드 Pod 허용 (단일 노드 시 true)
extend_k8s_certificates: true           # K8s 인증서 만료를 10년으로 연장
enable_rook_ceph_cleanup: false         # reset 시 rook-ceph 리소스 사전 정리


# ════════════════════════════════════════════════════════════════
# 2. HA / 도메인 통신
# 다중 마스터, kube-vip, 도메인 기반 통신, etcd, cert SAN.
# kube_vip_address 또는 enable_domain_communication 중 하나로 endpoint 결정.
# ════════════════════════════════════════════════════════════════
master_ha: true                         # 다중 마스터(HA) 구성 여부
kube_vip_port: 6443                     # kube-vip가 노출할 API server 포트
kube_vip_interface: ens18               # kube-vip가 바인딩할 NIC 이름
# kube_vip_address: 192.168.1.10        # 선택: VIP IP (생략 시 domain communication 사용)
kube_vip_svc_enable: false              # kube-vip Service 로드밸런서 활성화

enable_domain_communication: true       # 도메인 기반 통신 (IP 대신 FQDN)
domain_suffix: "k8s.local"              # 노드 FQDN suffix (예: master1.k8s.local)
api_domain: "k8s-api.internal"          # API server 도메인 (DNS/LB로 해석되어야 함)

# etcd 도메인 설정 (도메인 통신 활성 시 자동 적용)
etcd_domain_config:
  listen_peer_urls: "https://0.0.0.0:2380"
  listen_client_urls: "https://0.0.0.0:2379"
  initial_cluster_token: "etcd-cluster-1"
  initial_cluster_state: "new"

# API server / etcd 인증서에 추가할 SAN. master FQDN은 자동 포함됨.
extra_cert_sans:
  - "localhost"
  - "kubernetes"
  - "kubernetes.default"
  - "kubernetes.default.svc"
  - "kubernetes.default.svc.cluster.local"
  # - "k8s.example.com"


# ════════════════════════════════════════════════════════════════
# 3. 네트워크 / CNI
# CNI 플러그인 선택: flannel(기본) | cilium.
# cilium 오프라인 설치 시 cilium_offline_install + cilium_image_repository 설정.
# ════════════════════════════════════════════════════════════════
network_plugin: "flannel"               # CNI: "flannel" | "cilium"
cilium_version: "1.15.5"                # Cilium 버전 (network_plugin=cilium일 때)
cilium_cli_version: "v0.16.8"           # Cilium CLI 버전
cilium_arch: "amd64"                    # Cilium 바이너리 아키텍처: amd64 | arm64
cilium_offline_install: false           # 오프라인 설치: 사전 다운로드 CLI/이미지 사용
cilium_image_repository: ""             # 오프라인 시 내부 미러 (예: repo.example.com/cilium)


# ════════════════════════════════════════════════════════════════
# 4. 컨테이너 런타임 / 레지스트리
# containerd 버전·디렉토리, registry mirror, custom image repo,
# 오프라인 binary install, 전용 디스크 설정.
# 주의: registry_mirror_password 는 *반드시* 환경별로 교체.
# ════════════════════════════════════════════════════════════════
containerd_version: "2.2.0"             # 지원: 1.7.x – 2.2.x, 권장: 2.2.0 (config v3 자동)
containerd_limit_nproc: 100000          # systemd LimitNPROC
containerd_limit_nofile: 100000         # systemd LimitNOFILE
containerd_data_base_dir: ""            # containerd data 디렉토리 (빈 값=기본 /var/lib/containerd)

# 로컬 레지스트리 (단순 registry:2 컨테이너)

# 비안전(insecure) 레지스트리 (HTTP 또는 self-signed)
insecure_registries: []
  # - "192.168.1.10:5000"
  # - "harbor.example.com"
docker_log_max_size: "100m"             # docker/nerdctl 로그 최대 크기

# containerd 레지스트리 인증 (containerd config.toml hosts.toml 작성용)
containerd_registry_auth:
  - registry: "registry.test"           # 레지스트리 호스트
    insecure_skip_verify: true          # TLS 검증 skip
    username: ""
    password: ""
    auth: ""                            # 선택: base64(username:password)
    identitytoken: ""                   # 선택: token 인증
  - registry: "registry.local"
    insecure_skip_verify: true
    username: ""
    password: ""
    auth: ""
    identitytoken: ""

# Kubernetes 컴포넌트 이미지 레지스트리 (registry.k8s.io 미러)
enable_custom_image_repository: true    # 커스텀 이미지 레지스트리 사용
k8s_image_repository: "repo.example.com/external-hub/kubernetes"
coredns_image_repository: "repo.example.com/external-hub/kubernetes/coredns"
pause_image: "repo.example.com/external-hub/kubernetes/pause:3.10.1"  # pause 컨테이너 이미지

# Docker/nerdctl login 자격 증명
docker_login_required: true             # nerdctl login 수행 여부
docker_registries:
  - registry: "harbor.example.com"
    protocol: "https"                   # https | http
    username: "<your-registry-user>"
    password: "<your-registry-password>"
  - registry: "harbor.example.com"
    protocol: "http"
    username: "admin"
    password: "<your-harbor-admin-password>"

# /etc/hosts 추가: 레지스트리 도메인 → IP
registry_hosts:
  "harbor.example.com": "192.168.1.10"

# containerd registry mirror (내부 미러로 외부 레지스트리 우회)
enable_registry_mirror: true            # 레지스트리 미러 활성화
registry_mirror_host: "repo.example.com"           # 내부 미러 호스트
registry_mirror_user: "<your-registry-user>"
registry_mirror_password: "<your-registry-password>"
registry_mirror_path_prefix: ""         # 선택: 경로 prefix (예: "myproject")

# 외부 레지스트리 → 내부 미러 매핑
registry_mirror_mappings:
  "docker.io": "docker-io"
  "cr.fluentbit.io": "cr-fluentbit-io"
  "docker.getcollate.io": "docker-getcollate-io"
  "docker.gitea.com": "docker-gitea-com"
  "ecr-public.aws.com": "ecr-public-aws-com"
  "ghcr.io": "ghcr-io"
  "nvcr.io": "nvcr-io"
  "quay.io": "quay-io"
  "registry.cn-hangzhou.aliyuncs.com": "registry-cn-hangzhou-aliyuncs-com"
  "registry.k8s.io": "registry-k8s-io"

# 공식 패키지 저장소 사용 (온라인 환경)
enable_official_k8s_repo: false         # pkgs.k8s.io 공식 K8s 저장소 사용
enable_official_containerd_repo: false  # download.docker.com 공식 containerd 저장소 사용

# containerd 바이너리 직접 설치 (GitHub releases)
enable_containerd_binary_install: false # 패키지 매니저 대신 바이너리 설치
runc_version: "1.2.4"                   # runc 버전
containerd_binary_arch: "amd64"         # 아키텍처: amd64 | arm64

# containerd 전용 디스크 (⚠ 디스크 포맷됨!)
enable_containerd_disk: false           # 전용 디스크 마운트 활성화 (⚠ 데이터 손실)
containerd_disk_device: "/dev/sdb"      # 디바이스 (예: /dev/sdb, /dev/nvme1n1)
containerd_disk_fstype: "xfs"           # 파일시스템: ext4 | xfs
containerd_disk_mount_point: "/var/lib/containerd"  # 마운트 포인트
containerd_disk_mount_options: "defaults,noatime"   # fstab 마운트 옵션


# ════════════════════════════════════════════════════════════════
# 5. 시스템 / 호스트 / 시간
# 타임존·호스트명·sysctl·NTP·병렬 실행·custom_hosts·CoreDNS.
# parallel_execution: 0=완전 병렬, 1=순차, N=동시 N개.
# ════════════════════════════════════════════════════════════════
set_timezone: Asia/Seoul                # 시스템 타임존
configure_etc_hosts: true               # inventory 기반 /etc/hosts 구성
set_hostname_from_inventory: true       # inventory_hostname을 시스템 hostname으로 설정

# sysctl 커널 파라미터 (Kubernetes 권장 + 일반 튜닝)
k8s_sysctl_params:
  net.ipv4.ip_forward: 1
  net.bridge.bridge-nf-call-iptables: 1
  net.bridge.bridge-nf-call-ip6tables: 1
  vm.swappiness: 0
  fs.file-max: 2097152
  fs.inotify.max_user_watches: 524288
  fs.inotify.max_user_instances: 512
  net.netfilter.nf_conntrack_max: 1048576
  net.ipv4.tcp_max_syn_backlog: 8096
  net.core.netdev_max_backlog: 16384
  net.core.somaxconn: 32768
  vm.max_map_count: 262144

# NTP / chrony
use_local_ntp: true                     # true=master1을 NTP 서버로, false=외부 NTP
external_ntp_servers: {}                # 외부 NTP (use_local_ntp=false일 때)
  # - "pool.ntp.org"
  # - "time.google.com"
cluster_network: "192.168.0.0/16"       # 로컬 NTP 접근 허용 네트워크
chrony_service_name: "{{ 'chronyd' if ansible_os_family == 'RedHat' else 'chrony' }}"
chrony_config_path: "{{ '/etc/chrony.conf' if ansible_os_family == 'RedHat' else '/etc/chrony/chrony.conf' }}"

# 설치 단계별 병렬 실행 호스트 수 (0=전체 동시, 1=순차)
parallel_execution:
  system_preparation: 0                 # 시스템 준비 단계 (packages, containerd)
  package_installation: 0               # apt/yum 작업
  kubernetes_installation: 0            # kubeadm init/join

# 임의 호스트 매핑 (모든 노드의 /etc/hosts에 추가)
custom_hosts: {}
  # "myapp.example.com": "10.0.0.100"

configure_coredns_hosts: true           # registry_hosts/custom_hosts를 CoreDNS에 등록


# ════════════════════════════════════════════════════════════════
# 6. GPU / NVIDIA
# 드라이버 자동 설치 + containerd NVIDIA runtime + 노드 라벨링.
# GPU operator 사용 시 별도 문서 참조 (본 예제에서는 다루지 않음).
# ════════════════════════════════════════════════════════════════
enable_nvidia_driver_install: true      # NVIDIA 드라이버 자동 설치
nvidia_driver_version: "570.124.06"     # 드라이버 버전
nvidia_driver_download_url: "http://repo.example.com/rhel-repo2"  # .run 파일 호스팅 URL
nvidia_driver_filename: "NVIDIA-Linux-x86_64-{{ nvidia_driver_version }}.run"
nvidia_driver_install_options: "--silent --no-questions --ui=none --disable-nouveau"
enable_fix_nvidia_toolkit_path: false          # .run 설치 시 toolkit 경로 보정 (/usr/local/nvidia/toolkit → /usr/bin)
enable_nvidia_containerd_config: false  # containerd에 NVIDIA runtime 등록 (GPU 자동 감지)
enable_gpu_node_labels: true            # GPU 감지 노드에 gpu=on 라벨 자동 부여


# ════════════════════════════════════════════════════════════════
# 7. 인증 / 보안
# OIDC API server 인증, PodNodeSelector, 사용자 CA 인증서.
# OIDC issuer는 사전에 외부 IdP(Keycloak 등) 구성 필요.
# ════════════════════════════════════════════════════════════════
enable_oidc_apiserver: true             # API server OIDC 인증 활성화
domain_host: "example.com"              # OIDC issuer base 도메인
oidc_client_id: "kubernetes"            # OIDC client ID
oidc_username_claim: "preferred_username"  # JWT username claim
oidc_groups_claim: "client_roles"       # JWT groups claim
oidc_issuer_url: "https://keycloak.{{ domain_host }}/realms/<realm>"  # OIDC issuer URL
# oidc_username_prefix: ""              # 선택: username prefix (예: "oidc:")
# oidc_groups_prefix: ""                # 선택: groups prefix
# oidc_ca_file: ""                      # 선택: issuer self-signed CA 경로
# oidc_required_claim: ""               # 선택: 필수 claim (예: "groups=admins")

enable_pod_node_selector: true          # PodNodeSelector admission plugin 활성화

# 사용자 CA 인증서 (시스템 trust store에 설치)
enable_ca_certificates: false           # CA 설치 활성화
ca_certificates: []
  # - name: "internal-ca"               # 인라인 PEM
  #   content: |
  #     -----BEGIN CERTIFICATE-----
  #     ...
  #     -----END CERTIFICATE-----
  # - name: "harbor-ca"                 # URL 다운로드
  #   url: "https://harbor.example.com/ca.crt"
  # - name: "registry-ca"               # 로컬 경로
  #   path: "/root/certs/my-ca.crt"


# ════════════════════════════════════════════════════════════════
# 8. OS 패키지 / 오프라인 저장소
# Ubuntu/RHEL 패키지 목록, 오프라인 미러, 선택 패키지(nerdctl/helmfile).
# 다중 RHEL 저장소(rhel_repos)는 priority로 우선순위 제어.
# ════════════════════════════════════════════════════════════════
# 오프라인 미러 URL (origin 변경 시 사용)

# Ubuntu APT 커스텀 저장소
enable_ubuntu_repo: false               # 커스텀 Ubuntu APT 저장소 사용
ubuntu_repo_url: ""                     # 예: "http://repo.example.com/ubuntu-repo"
ubuntu_repo_components: "./"
ubuntu_repo_trusted: true               # 서명 검증 skip
ubuntu_repo_update_cache: true          # apt update 실행

# RHEL/Rocky YUM 저장소 (다중 지원)
enable_rhel_repos: true                 # 커스텀 RHEL 저장소 사용
rhel_repos:
  - name: "rhel-iso-repo"
    id: "rhel-iso-repo"
    url: "http://repo.example.com/rhel-repo"
    type: "baseos_appstream"            # "single" | "baseos_appstream"
    enabled: 1
    gpgcheck: 0
    priority: 1
  - name: "rhel-directory-repo"
    id: "rhel-directory-repo"
    url: "http://repo.example.com/rhel-repo2"
    type: "single"
    enabled: 1
    gpgcheck: 0
    priority: 2

# Ubuntu 필수 패키지
ubuntu_packages:
  - bash-completion
  - dnsmasq
  - jq
  - openssh-server
  - ca-certificates
  - nfs-common
  - nfs-kernel-server
  - net-tools
  - chrony
  - curl
  - wget
  - k9s

# Ubuntu 선택 패키지 (enable_nerdctl_buildkit=true 시)
enable_nerdctl_buildkit: false          # nerdctl + buildkit 설치
ubuntu_optional_packages:
  - nerdctl
  - buildkit

enable_helmfile: false                  # helmfile 설치 (masters 그룹만)

# Ubuntu masters 전용 패키지
ubuntu_master_only_packages:
  - make

# RHEL 필수 패키지
rhel_packages:
  - bash-completion
  - dnsmasq
  - jq
  - openssh-server
  - ca-certificates
  - tree
  - device-mapper-persistent-data
  - lvm2
  - chrony
  - curl
  - wget
  - which
  - k9s

# RHEL 선택 패키지 (없으면 무시)
rhel_optional_packages:
  - nfs-utils
  - yum-utils

# RHEL masters 전용 패키지
rhel_master_only_packages:
  - make

# 배포판 간 패키지명 매핑
package_name_map:
  nfs_client:
    Debian: nfs-common
    RedHat: nfs-utils
  nfs_server:
    Debian: nfs-kernel-server
    RedHat: nfs-utils
  network_tools:
    Debian: net-tools
    RedHat: net-tools
  time_sync:
    Debian: chrony
    RedHat: chrony
  helmfile:
    Debian: helmfile
    RedHat: helmfile-bundle
